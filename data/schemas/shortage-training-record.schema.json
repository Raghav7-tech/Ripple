{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ripple.example/schemas/shortage-training-record.schema.json",
  "title": "Ripple shortage training record",
  "type": "object",
  "required": [
    "schema_version", "record_id", "event_id", "split_group", "timestamp",
    "entity_id", "entity_type", "zone_id", "river_level_m",
    "river_rise_m_per_hour", "treatment_capacity_pct", "expected_supply_m3h",
    "expected_demand_m3h", "reserve_hours", "upstream_disruption_probability",
    "criticality", "horizon_hours", "shortage_within_horizon", "label_source",
    "evidence_status", "synthetic", "source_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "split_group": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "entity_id": {"type": "string", "minLength": 1},
    "entity_type": {"enum": ["locality", "school", "college", "restaurant", "healthcare"]},
    "zone_id": {"type": "string", "minLength": 1},
    "river_level_m": {"type": "number"},
    "river_rise_m_per_hour": {"type": "number"},
    "rainfall_mm_24h": {"type": "number", "minimum": 0},
    "max_temperature_c": {"type": "number"},
    "treatment_capacity_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "expected_supply_m3h": {"type": "number", "minimum": 0},
    "expected_demand_m3h": {"type": "number", "exclusiveMinimum": 0},
    "reserve_hours": {"type": "number", "minimum": 0},
    "upstream_disruption_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "outage_active": {"type": "boolean"},
    "criticality": {"type": "number", "minimum": 0, "maximum": 1},
    "sensor_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "horizon_hours": {"type": "integer", "minimum": 1, "maximum": 168},
    "shortage_within_horizon": {"type": "boolean"},
    "hours_to_shortage": {"type": ["number", "null"], "minimum": 0},
    "label_source": {"type": "string", "minLength": 1},
    "evidence_status": {"enum": ["verified", "inferred", "demonstration"]},
    "synthetic": {"type": "boolean"},
    "source_ids": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
