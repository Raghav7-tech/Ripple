# Base URL emitted by `sam deploy`, without a trailing slash.
# When set, the frontend connects to live backend routes including:
# - GET /health
# - POST /modeling/simulate (stateless CascadeEngine sandbox)
# - POST /forecasts/shortage
# Leave unset to keep Ripple in its labelled local replay mode (Modeling Lab will show API-unavailable guidance).
VITE_API_BASE_URL=https://example.execute-api.ap-south-1.amazonaws.com/demo
